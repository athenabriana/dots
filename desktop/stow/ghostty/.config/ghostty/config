# ghostty config — ghostty owns tabs/splits; tmux runs as a pure
# session-keeper (resurrect+continuum) behind it. Window chrome kept
# minimal; ghostty's tab title carries session context (tmux status
# bar is off).

window-decoration = false
window-show-tab-bar = auto
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
gtk-custom-css = ./custom.css

# --- Alt-prefixed tabs / splits (parity with the old tmux Alt-binds) ---
# Tabs
keybind = alt+t=new_tab
keybind = alt+q=close_surface
keybind = alt+h=previous_tab
keybind = alt+l=next_tab
keybind = alt+left=previous_tab
keybind = alt+right=next_tab
keybind = alt+shift+h=move_tab:-1
keybind = alt+shift+l=move_tab:1
keybind = alt+shift+left=move_tab:-1
keybind = alt+shift+right=move_tab:1
keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
keybind = alt+6=goto_tab:6
keybind = alt+7=goto_tab:7
keybind = alt+8=goto_tab:8
keybind = alt+9=goto_tab:9

# Splits
keybind = alt+d=new_split:right
keybind = alt+shift+d=new_split:down
keybind = alt+j=goto_split:bottom
keybind = alt+k=goto_split:top
keybind = alt+down=goto_split:bottom
keybind = alt+up=goto_split:top
