# Brewfile — system layer shared by every platform.
#
# Installed by `just sync` (_brew) via `brew bundle`. Brew itself is the
# only prerequisite (see README bootstrap; assumes curl/git/procps/file
# on the host, which Ubuntu/WSL ships).
#
# This holds ONLY the irreducible system layer — what must exist before
# mise can run, or what mise can't manage:
#   - zsh: the login shell (the chsh recipe registers the brew path in
#     /etc/shells before switching)
#   - git/curl: bootstrap — clone this repo
#   - mise: the tool manager itself; brew installs/upgrades the binary,
#     mise manages everything else (see _mise / _mise-upgrade)
#   - stow: the config linker
#   - just: runs this justfile
#   - unzip: some tool installers still expect it
#   - pass: password manager; pulls gnupg + pinentry as deps. The store
#     itself is a separate private repo (athenabriana/pass) synced by `_pass`.
#
# Below the system layer come the CLI apps: latest-only tools with no
# per-project pinning. Toolchains/runtimes (node, python, go, …) are
# managed by mise — see mise/.config/mise/config.toml — and mise wins
# over brew in PATH (04-brew.sh loads before 05-mise-shims.sh).
# Platform-specific extras go in <platform>/Brewfile.

# system layer
brew "zsh"
brew "git"
brew "curl"
brew "mise"
brew "stow"
brew "just"
brew "unzip"
brew "pass"

# CLI apps
brew "atuin"
brew "bat"
brew "carapace"
brew "eza"
brew "fzf"
brew "gh"
brew "git-delta"
brew "lazygit"
brew "ripgrep"
brew "sesh"
brew "sheldon"
brew "starship"
brew "television"
brew "zoxide"
