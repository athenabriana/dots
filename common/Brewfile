# Brewfile — system layer + CLI apps, shared by every platform.
#
# Applied by `just sync` (_brew) with `brew bundle` (install + cleanup) —
# the Brewfile is the complete, declarative list: anything installed but not
# listed here is uninstalled on sync. brew and mise are both installed
# standalone by their own installers (see README bootstrap); neither is a
# brew formula here — so `brew bundle cleanup` never removes mise.
#
# This holds the irreducible system layer — what must exist to run the
# justfile and what mise doesn't manage:
#   - zsh: the login shell (the chsh recipe registers the brew path in
#     /etc/shells before switching)
#   - git/curl: bootstrap — clone this repo
#   - stow: the config linker
#   - just: runs this justfile
#   - unzip: some tool installers still expect it
#
# Below the system layer come the CLI apps: latest-only tools with no
# per-project pinning. Toolchains/runtimes (node, python, go, …) are
# managed by mise — see mise/.config/mise/config.toml — and mise wins
# over brew in PATH (04-brew.sh loads before 05-mise-shims.sh).
# Platform-specific extras go in <platform>/Brewfile.

# system layer
brew "zsh"
brew "git"
brew "curl"
brew "stow"
brew "just"
brew "unzip"

# CLI apps
brew "atuin"
# wl-clipboard: clipboard from the CLI — WSLg exposes Wayland, so
# this works on WSL and desktop alike.
brew "wl-clipboard"
brew "bat"
brew "carapace"
brew "eza"
brew "fzf"
brew "gh"
brew "git-delta"
brew "lazygit"
brew "ripgrep"
brew "sesh"
brew "sheldon"
brew "starship"
brew "television"
brew "zoxide"
